//// Python's html.unescape, for the character references a .zenodo.json description can hold.
//// Numeric references follow Python exactly (the windows-1252 remap of 0x80..0x9F, U+FFFD for
//// surrogates and out-of-range values, nothing for the invalid code points), and named ones use
//// the whole HTML5 table (2231 names, html.entities.html5), with the longest-prefix rule
//// for the legacy names that may stand without a semicolon. The table was generated from
//// Python 3.14's html.entities.html5.

import gleam/int
import gleam/list
import gleam/string

/// html.unescape(s)
pub fn unescape(s: String) -> String {
  case string.contains(s, "&") {
    False -> s
    True ->
      go(
        string.to_utf_codepoints(s) |> list.map(string.utf_codepoint_to_int),
        [],
      )
  }
}

fn go(cs: List(Int), acc: List(String)) -> String {
  case cs {
    [] -> string.concat(list.reverse(acc))
    [0x26, 0x23, x, ..rest] if x == 0x78 || x == 0x58 ->
      case take(rest, is_hex, []) {
        #([], _) -> go([0x23, x, ..rest], ["&", ..acc])
        #(ds, after) -> numeric(ds, 16, after, acc)
      }
    [0x26, 0x23, ..rest] ->
      case take(rest, is_digit, []) {
        #([], _) -> go([0x23, ..rest], ["&", ..acc])
        #(ds, after) -> numeric(ds, 10, after, acc)
      }
    [0x26, ..rest] ->
      case take_name(rest, [], 0) {
        #([], _) -> go(rest, ["&", ..acc])
        #(name, after) ->
          case after {
            [0x3B, ..r] -> go(r, [named(list.append(name, [0x3B])), ..acc])
            _ -> go(after, [named(name), ..acc])
          }
      }
    [c, ..rest] -> go(rest, [text([c]), ..acc])
  }
}

fn numeric(
  ds: List(Int),
  base: Int,
  after: List(Int),
  acc: List(String),
) -> String {
  let after = case after {
    [0x3B, ..r] -> r
    _ -> after
  }
  let assert Ok(n) = int.base_parse(text(ds), base)
  go(after, [charref(n), ..acc])
}

fn take(
  cs: List(Int),
  ok: fn(Int) -> Bool,
  acc: List(Int),
) -> #(List(Int), List(Int)) {
  case cs {
    [c, ..rest] ->
      case ok(c) {
        True -> take(rest, ok, [c, ..acc])
        False -> #(list.reverse(acc), cs)
      }
    [] -> #(list.reverse(acc), cs)
  }
}

// [^\t\n\f <&#;]{1,32}
fn take_name(cs: List(Int), acc: List(Int), n: Int) -> #(List(Int), List(Int)) {
  case cs {
    [c, ..rest] if n < 32 ->
      case c {
        0x09 | 0x0A | 0x0C | 0x20 | 0x3C | 0x26 | 0x23 | 0x3B -> #(
          list.reverse(acc),
          cs,
        )
        _ -> take_name(rest, [c, ..acc], n + 1)
      }
    _ -> #(list.reverse(acc), cs)
  }
}

fn is_digit(c: Int) -> Bool {
  c >= 0x30 && c <= 0x39
}

fn is_hex(c: Int) -> Bool {
  is_digit(c) || { c >= 0x41 && c <= 0x46 } || { c >= 0x61 && c <= 0x66 }
}

fn text(cs: List(Int)) -> String {
  list.filter_map(cs, string.utf_codepoint) |> string.from_utf_codepoints
}

fn charref(n: Int) -> String {
  case n {
    0x00 -> "\u{FFFD}"
    0x0D -> "\r"
    _ if n >= 0x80 && n <= 0x9F -> windows_1252(n)
    _ if n >= 0xD800 && n <= 0xDFFF -> "\u{FFFD}"
    _ if n > 0x10FFFF -> "\u{FFFD}"
    _ if n >= 0x01 && n <= 0x08 -> ""
    _ if n >= 0x0E && n <= 0x1F -> ""
    _ if n == 0x0B || n == 0x7F -> ""
    _ if n >= 0xFDD0 && n <= 0xFDEF -> ""
    _ if n % 0x10000 == 0xFFFE || n % 0x10000 == 0xFFFF -> ""
    _ -> text([n])
  }
}

fn windows_1252(n: Int) -> String {
  case n {
    0x80 -> "\u{20AC}"
    0x81 -> "\u{81}"
    0x82 -> "\u{201A}"
    0x83 -> "\u{192}"
    0x84 -> "\u{201E}"
    0x85 -> "\u{2026}"
    0x86 -> "\u{2020}"
    0x87 -> "\u{2021}"
    0x88 -> "\u{2C6}"
    0x89 -> "\u{2030}"
    0x8A -> "\u{160}"
    0x8B -> "\u{2039}"
    0x8C -> "\u{152}"
    0x8D -> "\u{8D}"
    0x8E -> "\u{17D}"
    0x8F -> "\u{8F}"
    0x90 -> "\u{90}"
    0x91 -> "\u{2018}"
    0x92 -> "\u{2019}"
    0x93 -> "\u{201C}"
    0x94 -> "\u{201D}"
    0x95 -> "\u{2022}"
    0x96 -> "\u{2013}"
    0x97 -> "\u{2014}"
    0x98 -> "\u{2DC}"
    0x99 -> "\u{2122}"
    0x9A -> "\u{161}"
    0x9B -> "\u{203A}"
    0x9C -> "\u{153}"
    0x9D -> "\u{9D}"
    0x9E -> "\u{17E}"
    0x9F -> "\u{178}"
    _ -> ""
  }
}

/// A named reference (with its `;` when it had one): the whole name when it is known, else the
/// longest known prefix of at least two characters, else the text unchanged.
fn named(s: List(Int)) -> String {
  case entity(text(s)) {
    Ok(v) -> v
    Error(_) -> longest(list.length(s) - 1, s)
  }
}

fn longest(x: Int, s: List(Int)) -> String {
  case x > 1 {
    False -> "&" <> text(s)
    True ->
      case entity(text(list.take(s, x))) {
        Ok(v) -> v <> text(list.drop(s, x))
        Error(_) -> longest(x - 1, s)
      }
  }
}

