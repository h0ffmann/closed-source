{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just build:*)",
      "Bash(just check)",
      "Bash(just arxiv)",
      "Bash(just citation)",
      "Bash(just self-test)",
      "Bash(just site-build)",
      "Bash(just ouroboric-sources)",
      "Bash(just zenodo-dry-run:*)",
      "Bash(nix develop:*)",
      "Bash(pandoc:*)",
      "Bash(tools/fabric citation:*)",
      "Bash(tools/fabric refs-check:*)",
      "Bash(tools/fabric zenodo-upload --self-test)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(scripts/readme.sh:*)",
      "Bash(just readme-check)"
    ],
    "ask": [
      "Bash(tools/fabric zenodo-upload:*)",
      "Bash(scripts/release.sh:*)",
      "Bash(just release:*)",
      "Bash(just zenodo-draft:*)",
      "Bash(just zenodo-sandbox:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/readme.sh --hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/readme.sh --hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "compound-engineering@compound-engineering-plugin": true
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin",
        "ref": "compound-engineering-v3.30.3"
      }
    }
  }
}
